# ─── Shared local development defaults ────────────────────────────────────────
# Copy to .env and adjust. Every value here is a safe local placeholder;
# no real credentials belong in this file or anywhere else in the repo.

# Chain -----------------------------------------------------------------------
# Local anvil node started by docker-compose.
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_NAME=localhost
CHAIN_CONFIRMATIONS=0

# Datastores ------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017/dotlaunch
REDIS_URL=redis://redis:6379

# API -------------------------------------------------------------------------
PORT=8888
# Local-only signing secret. Generate a real one for any deployed environment.
JWT_SECRET=dotlaunch-local-development-secret
JWT_TTL=126000

# Storage ---------------------------------------------------------------------
# "local" writes uploads to disk so the stack runs with no internet access.
# "pinata" pins to IPFS and additionally requires PINATA_JWT.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8888/api/v1/storage
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Event listener --------------------------------------------------------------
EVENT_LISTENER_ENABLED=true
EVENT_LISTENER_BLOCK_RANGE=1000
EVENT_LISTENER_CRON=*/5 * * * * *
EVENT_LISTENER_START_BLOCK=0

# Contract addresses ----------------------------------------------------------
# Populated by `npm run seed`; leave blank for a fresh chain.
CONTRACT_LAUNCHPAD_DEPLOYER=
CONTRACT_TOKEN_LOCK=
CONTRACT_TOKEN_MANAGE=
CONTRACT_MULTISEND=

# Deployment (never commit real values) ---------------------------------------
# DEPLOYER_MNEMONIC=
# DEPLOYER_PRIVATE_KEY=
