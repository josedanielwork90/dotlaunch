# ─── docker-compose environment ───────────────────────────────────────────────
# Values used by `docker compose up`. Everything here is a local development
# default and safe to commit; no real credentials belong in this file.

# Chain -----------------------------------------------------------------------
CHAIN_ID=31337
CHAIN_NAME=Localhost
NATIVE_SYMBOL=ETH
EXPLORER_URL=http://localhost:8545
CHAIN_CONFIRMATIONS=0

# Contract addresses ----------------------------------------------------------
# Deterministic: a fresh anvil chain, the public development mnemonic and the
# fixed deployment order in scripts/deploy-all.js always produce these exact
# addresses. deploy-all.js writes them to deployments/localhost.json too; the
# values are duplicated here so the web container can be configured before the
# deployment volume is readable.
CONTRACT_LAUNCHPAD_DEPLOYER=0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_TOKEN_LOCK=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
CONTRACT_TOKEN_MANAGE=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
CONTRACT_MULTISEND=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# API -------------------------------------------------------------------------
NODE_ENV=production
PORT=8888
JWT_SECRET=dotlaunch-local-development-secret
JWT_TTL=126000

# Storage ---------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8888/api/v1/storage

# Event listener --------------------------------------------------------------
EVENT_LISTENER_ENABLED=true
EVENT_LISTENER_BLOCK_RANGE=1000
EVENT_LISTENER_CRON=*/5 * * * * *
# Leave unset to start from the block the contracts were deployed in.
# EVENT_LISTENER_START_BLOCK=

# Demo behaviour --------------------------------------------------------------
# Exposes the local chain's unlocked accounts as selectable wallets so the app
# is usable with no browser extension installed. Never enable against a live
# network.
DEMO_MODE=true

# Pins the app's clock to a fixed instant so countdowns, relative timestamps
# and time-derived sale states render identically on every run. The chain is
# started at the same instant (see DEMO_CHAIN_TIMESTAMP) so on-chain state and
# the interface agree.
FIXED_NOW=2025-06-15T12:00:00Z
DEMO_CHAIN_TIMESTAMP=1746100800

# Host port mappings ----------------------------------------------------------
# Only the browser-facing services are published. Mongo and Redis stay inside
# the compose network. Override any of these if a port is already in use.
WEB_PORT=3000
API_PORT=8888
ANVIL_PORT=8545
MONGO_PORT=27018
