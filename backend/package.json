{
  "name": "dot-launch-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src ../tests/backend --ext .js",
    "lint:fix": "eslint src ../tests/backend --ext .js --fix",
    "reset-eventlistener-state": "node src/loaders/bscEventListener/scripts/resetListenerState.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.1",
    "bull": "^4.10.2",
    "celebrate": "^15.0.1",
    "cors": "^2.8.5",
    "cron": "^2.1.0",
    "ethers": "^5.7.2",
    "express": "^4.18.2",
    "express-jwt": "^8.2.1",
    "mongoose": "^6.8.2",
    "mongoose-paginate-v2": "^1.7.1",
    "typedi": "^0.10.0",
    "ulid": "^2.3.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "testMatch": [
      "<rootDir>/tests/backend/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/backend/setup.js"
    ],
    "modulePaths": [
      "<rootDir>/backend/node_modules"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/app.js",
      "!backend/src/loaders/bscEventListener/config/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "testTimeout": 30000
  }
}
